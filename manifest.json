{
  "manifest_version": 3,
  "name": "LexUDF — UYAP Dilekçe Asistanı",
  "short_name": "LexUDF",
  "version": "1.2.0",
  "description": "Çoklu avukat profili hafızalı UYAP UDF dilekçe asistanı.",
  "permissions": [
    "downloads",
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "LexUDF Dilekçe Paneli"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
