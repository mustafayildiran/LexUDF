{
  "manifest_version": 3,
  "name": "LexUDF — UYAP Dilekçe Asistanı",
  "short_name": "LexUDF",
  "version": "1.1.1",
  "description": "UYAP uyumlu UDF dilekçeleri: matbu şablonlar, portalda tek tıkla taslak, çoklu avukat profili, cihaz içi çalışır.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "LexUDF Dilekçe Paneli"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://avukat.uyap.gov.tr/*"],
      "js": ["portal/content-uyap-sablon.js"],
      "css": ["portal/content-uyap-sablon.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}